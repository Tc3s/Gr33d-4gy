# D-Bus Keyring Helper Functions (for GNOME Keyring / Secret Service)
try:
    import dbus

    def _get_keyring_collection(bus):
        for path in ["/org/freedesktop/secrets/aliases/default", "/org/freedesktop/secrets/collection/login"]:
            try:
                obj = bus.get_object("org.freedesktop.secrets", path)
                col = dbus.Interface(obj, "org.freedesktop.Secret.Collection")
                col.Get("org.freedesktop.Secret.Collection", "Label", dbus_interface="org.freedesktop.DBus.Properties")
                return obj, col
            except Exception:
                continue
        return None, None

    def get_keyring_item(bus=None):
        try:
            if bus is None:
                bus = dbus.SessionBus()
            obj, col = _get_keyring_collection(bus)
            if not col:
                return None
            items = col.Get("org.freedesktop.Secret.Collection", "Items", dbus_interface="org.freedesktop.DBus.Properties")
            for item_path in items:
                item_obj = bus.get_object("org.freedesktop.secrets", item_path)
                attrs = item_obj.Get("org.freedesktop.Secret.Item", "Attributes", dbus_interface="org.freedesktop.DBus.Properties")
                if attrs.get("service") == "gemini" and attrs.get("username") == "antigravity":
                    return item_obj
        except Exception:
            pass
        return None

    def get_keyring_secret():
        try:
            bus = dbus.SessionBus()
            item_obj = get_keyring_item(bus)
            if not item_obj:
                return None
            service = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
            svc_iface = dbus.Interface(service, "org.freedesktop.Secret.Service")
            session_path = svc_iface.OpenSession("plain", "")[1]
            secret = item_obj.GetSecret(session_path, dbus_interface="org.freedesktop.Secret.Item")
            return bytes(secret[2]).decode("utf-8")
        except Exception:
            return None

    def set_keyring_secret(secret_str: str):
        try:
            bus = dbus.SessionBus()
            service = bus.get_object("org.freedesktop.secrets", "/org/freedesktop/secrets")
            svc_iface = dbus.Interface(service, "org.freedesktop.Secret.Service")
            session_path = svc_iface.OpenSession("plain", "")[1]

            secret_bytes = secret_str.encode("utf-8")
            secret_struct = dbus.Struct((
                session_path,
                dbus.Array([], signature="y"),
                dbus.ByteArray(secret_bytes),
                dbus.String("text/plain")
            ), signature="oayays")

            existing_item = get_keyring_item(bus)
            if existing_item:
                existing_item.SetSecret(secret_struct, dbus_interface="org.freedesktop.Secret.Item")
                return True

            obj, col = _get_keyring_collection(bus)
            if not col:
                return False

            props = dbus.Dictionary({
                "org.freedesktop.Secret.Item.Label": dbus.String("Password for 'antigravity' on 'gemini'"),
                "org.freedesktop.Secret.Item.Attributes": dbus.Dictionary({
                    "service": "gemini",
                    "username": "antigravity"
                }, signature="ss")
            }, signature="sv")

            col.CreateItem(props, secret_struct, True)
            return True
        except Exception:
            return False

    def delete_keyring_secret():
        try:
            bus = dbus.SessionBus()
            item_obj = get_keyring_item(bus)
            if item_obj:
                item_obj.Delete(dbus_interface="org.freedesktop.Secret.Item")
                return True
        except Exception:
            pass
        return False

except ImportError:
    def get_keyring_secret(): return None
    def set_keyring_secret(secret_str: str): return False
    def delete_keyring_secret(): return False

