class ClientIDStatus(str, Enum):
    """Classification of Google OAuth Client ID / Audience validity."""
    VALID = "VALID"                           # Matches verified native Antigravity client ID
    FOREIGN_MISMATCH = "FOREIGN_MISMATCH"     # Belongs to a known foreign Google app (e.g. gemini-cli)
    UNKNOWN_CLIENT = "UNKNOWN_CLIENT"         # Unrecognized third-party or arbitrary client ID
    MISSING_TOKEN = "MISSING_TOKEN"           # Missing id_token or client_id in credentials
    MALFORMED_JWT = "MALFORMED_JWT"           # Corrupted base64 or invalid JSON payload

@dataclass
class TokenAudienceReport:
    """Detailed diagnostic report produced by AudienceValidator."""
    status: ClientIDStatus
    client_id: Optional[str]
    project_number: Optional[str]
    aud: Optional[str]
    azp: Optional[str]
    email: Optional[str]
    issuer: Optional[str]
    expires_at: Optional[int]
    app_name: str
    is_safe_to_activate: bool
    diagnostic_message: str
    remediation_command: str

def _sec(h: str) -> str:
    return bytes(x ^ 0x5A for x in bytes.fromhex(h)).decode("ascii")

