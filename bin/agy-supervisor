# Event Classification Types
class LogEventType(str, Enum):
    NONE = "EVENT_NONE"
    QUOTA_EXHAUSTED = "EVENT_QUOTA_EXHAUSTED"
    ACCOUNT_NOTICE = "EVENT_ACCOUNT_NOTICE"
    AUTH_FAILURE = "EVENT_AUTH_FAILURE"
    TRANSIENT_503 = "EVENT_TRANSIENT_503"
    # Aliases
    QUOTA_DAILY = "EVENT_QUOTA_EXHAUSTED"
    QUOTA_RPM = "EVENT_QUOTA_EXHAUSTED"

# Backward-compatible aliases matching PROJECT.md interface contract
EVENT_NONE = LogEventType.NONE
EVENT_QUOTA_EXHAUSTED = LogEventType.QUOTA_EXHAUSTED
EVENT_QUOTA_DAILY = LogEventType.QUOTA_DAILY
EVENT_QUOTA_RPM = LogEventType.QUOTA_RPM
EVENT_ACCOUNT_NOTICE = LogEventType.ACCOUNT_NOTICE
EVENT_AUTH_FAILURE = LogEventType.AUTH_FAILURE
EVENT_TRANSIENT_503 = LogEventType.TRANSIENT_503

@dataclass
class LogEventClassification:
    event_type: LogEventType
    raw_line: bytes = b""
    message: str = ""
    reset_seconds: int = 0
    is_daily: bool = False
    status_code: Optional[int] = None
    reason: str = ""
    raw_match: str = ""

    def __post_init__(self):
        if not self.raw_match and self.raw_line:
            self.raw_match = self.raw_line.decode("utf-8", errors="ignore")
        elif not self.raw_line and self.raw_match:
            self.raw_line = self.raw_match.encode("utf-8")
        if not self.message:
            self.message = self.reason

    @property
    def is_quota(self) -> bool:
        return self.event_type in (
            LogEventType.QUOTA_EXHAUSTED,
            "EVENT_QUOTA_EXHAUSTED",
            "QUOTA_EXHAUSTED",
            "QUOTA_DAILY",
            "QUOTA_RPM",
            "EVENT_QUOTA_DAILY",
            "EVENT_QUOTA_RPM",
        )

    @property
    def is_terminal(self) -> bool:
        return self.is_quota or self.is_suspension

    @property
    def is_suspension(self) -> bool:
        return self.event_type in (
            LogEventType.ACCOUNT_NOTICE,
            LogEventType.AUTH_FAILURE,
            "EVENT_ACCOUNT_NOTICE",
            "EVENT_AUTH_FAILURE",
            "ACCOUNT_NOTICE",
            "AUTH_FAILURE",
        )

    @property
    def is_transient(self) -> bool:
        return self.event_type in (
            LogEventType.TRANSIENT_503,
            "EVENT_TRANSIENT_503",
            "TRANSIENT_503",
        )

    @property
    def is_fatal(self) -> bool:
        return self.is_terminal

    @property
    def should_terminate(self) -> bool:
        return self.is_terminal

    @property
    def should_rotate(self) -> bool:
        return self.is_terminal

    def __bool__(self) -> bool:
        return self.event_type not in (LogEventType.NONE, "EVENT_NONE", "NONE")

class SessionResult(tuple):
    """
    3-tuple subclass for backward compatibility:
    Allows unpacking: quota_hit, reset_secs, is_daily = run_session(...)
    While also providing access to .event, .classification, .hit, .reset_secs, .is_daily, .event_detected.
    """
    def __new__(cls, hit: bool, reset_secs: int, is_daily: bool, event: Optional[LogEventClassification] = None):
        instance = super().__new__(cls, (hit, reset_secs, is_daily))
        instance.hit = hit
        instance.reset_secs = reset_secs
        instance.is_daily = is_daily
        instance.event = event
        instance.classification = event
        instance.event_detected = hit
        return instance

